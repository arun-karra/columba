# Public client env — baked into the JS bundle, so this is not a secret.
# Set the same variable in EAS Environment Variables (visibility: Public)
# for development / preview / production. Do not put it in eas.json.
#
# Omit for local Simulator dev — the app falls back to http://localhost:8080.
EXPO_PUBLIC_DOMAIN=your-api-host.example.com

# Optional: allow the 20-tap logo dev bypass in non-__DEV__ builds (e.g. simulator dev client).
# EXPO_PUBLIC_ENABLE_DEV_BYPASS=true
