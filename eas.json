{
  "cli": {
    "version": ">= 22.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "credentialsSource": "remote",
      "ios": {
        "simulator": false
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "simulator": true
      },
      "withoutCredentials": true
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "credentialsSource": "remote"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "credentialsSource": "remote"
    }
  },
  "submit": {
    "production": {}
  }
}
